{
  "manifest_version": 3,
  "name": "E-Commerce Optimizer",
  "version": "1.0.0",
  "description": "Analyze e-commerce websites and generate optimized conversion-focused templates",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "fetch"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "E-Commerce Optimizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["preview.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
