{
  "manifest_version": 3,
  "name": "E-Commerce Optimizer",
  "version": "1.0.0",
  "description": "Analyze e-commerce websites and generate optimized conversion-focused templates",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "E-Commerce Optimizer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
